# Copy this file to ".env" (in this mod folder) and set your own 3P server.
# The official server does NOT support 3 players.
server_url=127.0.0.1
server_port=8788

# --- Steam peer-to-peer mode (no server / tunnel needed) ---
# mode=steam      -> host runs the game server inside Balatro, friends join with the lobby code over Steam.
# (leave out / mode=tcp -> normal TCP server using server_url/server_port above)
#mode=steam
# Diagnostics (off by default): host a lobby by itself at startup and log "P2P-SELFTEST" lines
#p2p_selftest=true

# Update check (on by default): set to false to never contact GitHub for new versions
#update_check=false
