{
  "_comment": "King of the Hill rule vectors, shared by mod/tests/test_koth.lua and server/test/koth.test.mjs",
  "cases": [
    { "name": "first PvP crowns the top scorer", "state": { "kingId": null, "streak": 0 },
      "scores": { "A": 100, "B": 200, "C": 50 },
      "expect": { "kingId": "B", "streak": 1, "crowned": true, "reward": 0, "loser": "C" } },
    { "name": "King tops again: streak +1", "state": { "kingId": "B", "streak": 1 },
      "scores": { "A": 100, "B": 300, "C": 50 },
      "expect": { "kingId": "B", "streak": 2, "reward": 0, "loser": "C" } },
    { "name": "beating the King claims the bounty", "state": { "kingId": "B", "streak": 2 },
      "scores": { "A": 400, "B": 300, "C": 50 },
      "expect": { "kingId": "A", "streak": 1, "claimedBy": "A", "prevKingId": "B", "claimedBounty": 2, "reward": 8, "lifeBonus": false, "loser": "C" } },
    { "name": "King lowest: crown shield, big bounty gives a life", "state": { "kingId": "B", "streak": 3 },
      "scores": { "A": 400, "B": 10, "C": 50 },
      "expect": { "kingId": "A", "streak": 1, "claimedBy": "A", "claimedBounty": 3, "reward": 12, "lifeBonus": true, "shieldedId": "B", "loser": null } },
    { "name": "King lowest, top tied: crown vacant, no claim", "state": { "kingId": "B", "streak": 2 },
      "scores": { "A": 400, "B": 10, "C": 400 },
      "expect": { "kingId": null, "streak": 0, "reward": 0, "shieldedId": "B", "prevKingId": "B", "loser": null } },
    { "name": "King tied for top: keeps crown, streak unchanged", "state": { "kingId": "B", "streak": 1 },
      "scores": { "A": 400, "B": 400, "C": 50 },
      "expect": { "kingId": "B", "streak": 1, "reward": 0, "loser": "C" } },
    { "name": "hold the hill: 4th straight win wins the match", "state": { "kingId": "B", "streak": 3 },
      "scores": { "A": 100, "B": 500, "C": 50 },
      "expect": { "kingId": "B", "streak": 4, "winnerId": "B", "loser": "C" } },
    { "name": "King left: crown resets, next top is crowned", "state": { "kingId": "X", "streak": 2 },
      "scores": { "A": 10, "B": 20 },
      "expect": { "kingId": "B", "streak": 1, "crowned": true, "reward": 0, "loser": "A" } },
    { "name": "hold target option 3", "options": { "koth_hold_target": "3" }, "state": { "kingId": "A", "streak": 2 },
      "scores": { "A": 900, "B": 20, "C": 30 },
      "expect": { "kingId": "A", "streak": 3, "winnerId": "A", "loser": "B" } },
    { "name": "two players left: beaten King is shielded", "state": { "kingId": "A", "streak": 1 },
      "scores": { "A": 10, "B": 20 },
      "expect": { "kingId": "B", "streak": 1, "claimedBy": "B", "claimedBounty": 1, "reward": 4, "shieldedId": "A", "loser": null } },
    { "name": "all tied: no King, nobody loses", "state": { "kingId": null, "streak": 0 },
      "scores": { "A": 5, "B": 5, "C": 5 },
      "expect": { "kingId": null, "streak": 0, "reward": 0, "loser": null } },
    { "name": "bounty money option", "options": { "koth_bounty_money": "10" }, "state": { "kingId": "C", "streak": 2 },
      "scores": { "A": 1, "B": 900, "C": 30 },
      "expect": { "kingId": "B", "claimedBy": "B", "reward": 20, "loser": "A" } }
  ]
}
